PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/feature_flag_platform
# Optional elevated credential used only for schema/data migrations; keep separate from runtime credentials.
MONGODB_MIGRATION_URI=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters-long
FRONTEND_ORIGIN=http://localhost:5173
# Optional deployment mode. Use production only behind HTTPS.
NODE_ENV=development
# Refresh token cookie: defaults to lax in development and none in production.
# Set to lax/strict only when the frontend and API are on the same site.
REFRESH_COOKIE_SAME_SITE=

# MongoDB must be a replica set/sharded cluster for atomic audited writes in all normal modes.
# Standalone MongoDB is rejected unless this development-only escape hatch is explicitly enabled.
MONGODB_ALLOW_NON_TRANSACTIONAL_DEV=false
# Production: Redis is required for shared rate limits across API instances.
REDIS_URL=redis://127.0.0.1:6379
# Optional: protects GET /metrics. Use a random 32+ character secret, or leave unset.
METRICS_TOKEN=
# Set this explicitly in production: 1 for exactly one trusted proxy, 0 if directly exposed,
# or comma-separated trusted IP/CIDR ranges. Never use true in production.
TRUST_PROXY=0
# Production rollout guard defaults: +25 percentage points per increase and 15-minute cooldown.
PROD_ROLLOUT_MAX_STEP=25
PROD_ROLLOUT_COOLDOWN_MS=900000
# Rollout policy accepts integer values only. Increases are capped at 25 percentage points,
# then held for 15 minutes. Decreases are always allowed for emergency mitigation.

# Project invitation email delivery via Resend. In development only, if unset,
# the API returns a copyable invite URL; production requires all three values.
RESEND_API_KEY=
EMAIL_FROM=FlagPilot <invites@example.com>
INVITATION_TTL_HOURS=168

# Optional GitHub App integration. Configure these exact URLs in the GitHub App settings:
# Setup URL: https://YOUR_API_HOST/api/v1/github/installations/callback
# User authorization callback URL: https://YOUR_API_HOST/api/v1/github/oauth/callback
# Webhook URL: https://YOUR_API_HOST/api/v1/github/webhooks
# Subscribe to: deployment_status, installation, installation_repositories.
# Grant repository permission Deployments: Read. Metadata: Read is automatic.
# The webhook secret and RSA private key remain in this env file only.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://YOUR_API_HOST/api/v1/github/oauth/callback

# Google Sign-In (OpenID Connect). Leave all three blank to disable the button flow.
# Create a Google OAuth Client ID of type "Web application" and register the exact callback URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=
# Optional restriction to Google Workspace hosted domains, e.g. company.com, subsidiary.com. Leave blank to allow any verified Gmail/Workspace account.
GOOGLE_ALLOWED_HOSTED_DOMAINS=
