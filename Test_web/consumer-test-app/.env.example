# The Vite proxy provides a same-origin path to the local FlagPilot backend.
# Do not point this setting directly at localhost:8000 for this local test app.
VITE_FLAGPILOT_API_URL=http://localhost:5180/flagpilot-api/api/v1

# Copy these two public client keys from Virat Technologies -> SDK & API.
VITE_FLAGPILOT_DEV_CLIENT_KEY=fp_dev_REPLACE_WITH_VIRAT_DEVELOPMENT_KEY
VITE_FLAGPILOT_PROD_CLIENT_KEY=fp_prod_REPLACE_WITH_VIRAT_PRODUCTION_KEY

# Start in Development. Switch to Production only after a flag exists there.
VITE_FLAGPILOT_ENVIRONMENT=dev
VITE_FLAGPILOT_TEST_FLAG=new_checkout
